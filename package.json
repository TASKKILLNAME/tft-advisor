{
  "name": "tft-advisor",
  "version": "1.1.0",
  "description": "TFT 실시간 보조 프로그램 (Vanguard 안전)",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "jimp": "^1.6.0",
    "node-fetch": "^2.7.0",
    "screenshot-desktop": "^1.15.3",
    "ws": "^8.19.0"
  },
  "build": {
    "appId": "com.tft.advisor",
    "productName": "TFT Advisor",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "TFT-Advisor-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TFT Advisor",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "category": "public.app-category.games",
      "icon": "assets/icon.icns",
      "artifactName": "TFT-Advisor-${version}.dmg"
    }
  }
}
